<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox disabled for system-wide monitoring -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	
	<!-- Camera access for periodic photo capture -->
	<key>com.apple.security.device.camera</key>
	<true/>
	
	<!-- File access for user-selected files -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	
	<!-- Apple Events for app monitoring -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	
	<!-- ============================================== -->
	<!-- HARDENED RUNTIME EXCEPTIONS                   -->
	<!-- Required for input monitoring and CGEvent     -->
	<!-- ============================================== -->
	
	<!-- Allow unsigned executable memory (for CGEvent tap) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	
	<!-- Allow DYLD environment variables if needed -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<false/>
	
	<!-- Disable library validation for flexibility -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
